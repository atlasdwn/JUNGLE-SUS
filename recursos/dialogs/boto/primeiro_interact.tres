[sub_resource type="Resource" id="sub_37"]
script = ExtResource("1_txt")
text = "Tudo bem, o Boto dá um jeito."
char_info = ExtResource("2_bot")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="sub_38"]
