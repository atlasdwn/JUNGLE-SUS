[sub_resource type="Resource" id="aw001"]
script = ExtResource("1_baw01")
text = "Finalmente você voltou."
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw002"]
script = ExtResource("1_baw01")
text = "Conseguiu nossa bagagem de volta?"
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw003"]
script = ExtResource("1_baw01")
text = "Ainda não."
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw004"]
script = ExtResource("1_baw01")
text = "E o que você tá fazendo aqui então, abestada?"
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw005"]
script = ExtResource("1_baw01")
text = "Vim ver como você tá, seu mal-agradecido!"
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw006"]
script = ExtResource("1_baw01")
text = "...enfim."
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw007"]
script = ExtResource("1_baw01")
text = "E o motor?"
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw008"]
script = ExtResource("1_baw01")
text = "Estou quase lá. Me dá alguns minutos."
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw009"]
script = ExtResource("1_baw01")
text = "Minutos ou horas?"
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw010"]
script = ExtResource("1_baw01")
text = "..."
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw011"]
script = ExtResource("1_baw01")
text = "Minutos."
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw012"]
script = ExtResource("1_baw01")
text = "Beleza. O pessoal não vem ajudar?"
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw013"]
script = ExtResource("1_baw01")
text = "Tu acha mesmo que eles iam perder tempo com isso? Se não for pra fazer dinheiro, eles não pisam por essas bandas."
char_info = ExtResource("2_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="aw014"]
script = ExtResource("1_baw01")
text = "É, não estou surpresa."
char_info = ExtResource("3_baw01")
portrait_index = null
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

