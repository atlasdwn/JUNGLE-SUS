[sub_resource type="Resource" id="ajuda001"]
script = ExtResource("1_baw01")
text = "Carina! Ainda bem que você voltou! O casco do barco furou quando batemos no banco de areia com o susto da Iara!"
char_info = ExtResource("2_baw01")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="ajuda002"]
script = ExtResource("1_baw01")
text = "Eu preciso de 5 pedaços de madeira pra tapar o buraco e consertar o barco, senão a gente não sai daqui."
char_info = ExtResource("2_baw01")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="ajuda003"]
script = ExtResource("1_baw01")
text = "Deixa comigo, Carlos. Vou procurar por aí."
char_info = ExtResource("3_baw01")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

