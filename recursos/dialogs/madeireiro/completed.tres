[sub_resource type="Resource" id="Resource_swwlx"]
script = ExtResource("1_51bxc")
text = "Aqui."
char_info = ExtResource("2_6mp4j")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_6mp4j"]
script = ExtResource("1_51bxc")
text = "Eita... tu achou mesmo, ein. 
Passa pra cá."
char_info = ExtResource("4_qfwtf")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_60qwc"]
script = ExtResource("1_51bxc")
text = "Os remédios primeiro. Não sei se gosto da ideia de ficar perto de alguém com um machado."
char_info = ExtResource("2_6mp4j")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_y05tv"]
script = ExtResource("1_51bxc")
text = "E eu muito menos."
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_xupud"]
script = ExtResource("1_51bxc")
text = "Eu to falando sério."
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_a56yw"]
script = ExtResource("1_51bxc")
text = "Mas tu não para de encher meu saco... Tá bom, toma."
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_np6cj"]
script = ExtResource("1_51bxc")
text = "Foi um desprazer fazer negócio, seu abutre."
char_info = ExtResource("2_6mp4j")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_s15rj"]
script = ExtResource("1_51bxc")
text = "Tanto faz. Some logo da minha frente, menina."
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

