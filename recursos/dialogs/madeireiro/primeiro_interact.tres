[gd_resource type="Resource" script_class="DialogResource" format=3 uid="uid://cmo1khj8m2ssx"]

[ext_resource type="Script" uid="uid://df0mmluyebmg3" path="res://recursos/dialogs/scripts/dialog_item.gd" id="1_b7x3b"]
[ext_resource type="Script" uid="uid://ba7gawa2x48ms" path="res://recursos/dialogs/scripts/dialog_text.gd" id="1_fan28"]
[ext_resource type="Resource" uid="uid://ld8ty8apvv22" path="res://recursos/personagens/karina_data.tres" id="2_8hb7l"]
[ext_resource type="Resource" uid="uid://cx1x2rlqha3je" path="res://recursos/personagens/madeireiro_data.tres" id="3_p6swj"]
[ext_resource type="Script" uid="uid://fq0jowlitt7b" path="res://recursos/dialogs/scripts/dialog_resource.gd" id="4_olc50"]
[ext_resource type="Script" uid="uid://wryjswybcgh3" path="res://recursos/dialogs/scripts/dialog_choice.gd" id="5_cjntt"]

[sub_resource type="Resource" id="Resource_bv3q1"]
script = ExtResource("1_fan28")
text = "Eu te conheço?"
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_8v5rc"]
script = ExtResource("1_fan28")
text = "Não."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_rvc7g"]
script = ExtResource("1_fan28")
text = "..."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_b7x3b"]
script = ExtResource("1_fan28")
text = "..."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_cjntt"]
script = ExtResource("1_fan28")
text = "Você tá desmatando?"
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_7fegv"]
script = ExtResource("1_fan28")
text = "Tô lucrando, tem diferença."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_s3f70"]
script = ExtResource("1_fan28")
text = "As árvores estão sendo cortadas do mesmo jeito."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_8jiyk"]
script = ExtResource("1_fan28")
text = "Não posso fazer nada."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_5n686"]
script = ExtResource("1_fan28")
text = "...Tá.  Você viu uma maleta médica por aí?"
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_33vf4"]
script = ExtResource("1_fan28")
text = "Se eu vi estava vazia, mas eu achei umas cartelas de comprimidos e umas ampolas pela mata."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_t1mtd"]
script = ExtResource("1_fan28")
text = "..."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_thrmm"]
script = ExtResource("1_fan28")
text = "São seus?"
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_8dsg7"]
script = ExtResource("1_fan28")
text = "São. É medicação para Malária."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_wkra0"]
script = ExtResource("1_fan28")
text = "Você não vai me devolver, né?"
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_5uhuu"]
script = ExtResource("1_fan28")
text = "Claro que não. Mas posso pensar no teu caso se você conseguir achar meu machado."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_3vfc4"]
script = ExtResource("1_fan28")
text = "Isso não é um jogo. Tem uma criança na vila com Malária grave. Se eu não começar o tratamento hoje, a infecção vai atingir o cérebro e ela não vai resistir."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_i1dos"]
script = ExtResource("1_fan28")
text = "Veio aqui bancar a heroína do SUS, foi? O problema dela não me comove. Se quer a medicação, me dá o machado."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_jc5lg"]
script = ExtResource("1_fan28")
text = "Ugh..."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_g4mm0"]
script = ExtResource("1_fan28")
text = "Tá bom, vou procurar seu machado. Onde foi a última vez que você o viu?"
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_7ndir"]
script = ExtResource("1_fan28")
text = "É o seguinte... ele tá com uma velha."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_gkdef"]
script = ExtResource("1_fan28")
text = "..."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_8mpeu"]
script = ExtResource("1_fan28")
text = "Sua mãe?"
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_716kg"]
script = ExtResource("1_fan28")
text = "O quê?! Não!"
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_bd34i"]
script = ExtResource("1_fan28")
text = "Enfim, quando cheguei aqui ontem de manhã, essa velha já estava aqui, do lado das minhas máquinas.
Ela ficava mandando eu ir embora, mas essa área É MINHA!"
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_ifoat"]
script = ExtResource("1_fan28")
text = "Agora, acontece que o meu machado sumiu e, coincidentemente, ELA TAMBÉM!"
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_huvfe"]
script = ExtResource("1_fan28")
text = "Então... você quer que eu procure por alguém armado... e você nem sequer sabe onde essa pessoa está?"
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_ojm4q"]
script = ExtResource("1_fan28")
text = "Você tem alguma escolha? É isso, ou nada."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_x8hne"]
script = ExtResource("1_fan28")
text = "Só porque eu sou uma cara legal... quando ela foi embora no momento em que a gente se encontrou, ela havia ido em direção à área que fica atravessando meu terreno. Você pode entrar."
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_w7io2"]
script = ExtResource("1_fan28")
text = "Ok..."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_omvic"]
script = ExtResource("1_fan28")
text = "Isso não vai acontecer."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_1cvyy"]
script = ExtResource("1_fan28")
text = "Eu fiz um juramento para salvar vidas, não para ajudar a destruir nossa floresta. Eu vou dar o meu jeito."
char_info = ExtResource("2_8hb7l")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_fvap7"]
script = ExtResource("1_fan28")
text = "Bom... tomara que aquela criancinha resista à febre da malária enquanto você tenta bancar a santa. Ha ha ha!"
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://ba7gawa2x48ms"

[sub_resource type="Resource" id="Resource_f70r5"]
script = ExtResource("5_cjntt")
choice_id = "quest_madeireiro"
text = "Ache ruim o quanto quiser. Sem meu machado, sem remédios. A doença só vai piorar.
O que você prefere?"
accept_dialogs = Array[ExtResource("1_b7x3b")]([SubResource("Resource_g4mm0"), SubResource("Resource_7ndir"), SubResource("Resource_gkdef"), SubResource("Resource_8mpeu"), SubResource("Resource_716kg"), SubResource("Resource_bd34i"), SubResource("Resource_ifoat"), SubResource("Resource_huvfe"), SubResource("Resource_ojm4q"), SubResource("Resource_x8hne"), SubResource("Resource_w7io2")])
refuse_dialogs = Array[ExtResource("1_b7x3b")]([SubResource("Resource_omvic"), SubResource("Resource_1cvyy"), SubResource("Resource_fvap7")])
char_info = ExtResource("3_p6swj")
metadata/_custom_type_script = "uid://wryjswybcgh3"

