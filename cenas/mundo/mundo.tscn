[sub_resource type="GDScript" id="GDScript_d083j"]
script/source = "@tool
extends Node2D

# =============================================================
#  GERADOR DE MUNDO — Jungle SUS
#  Anexe esse script no nó raiz da cena mundo.tscn
#  Depois vá em: Projeto > Ferramentas > Gerar Mundo
#  OU clique no botão no Inspector enquanto o nó está selecionado
# =============================================================

const TILE_SIZE := 16

# --- Dimensões do mapa (em tiles) ---
const MAPA_LARGURA  := 160   # tiles horizontais
const MAPA_ALTURA   := 90    # tiles verticais
const MAPA_OFFSET_X := -80   # para centralizar no (0,0)
const MAPA_OFFSET_Y := -45

# --- Source IDs no TileSet (conforme configurado no editor) ---
const SOURCE_WATER := 0   # Water_tiles.png -> atlas source 0 no tileset de água
const SOURCE_FLOOR := 0   # Floors_Tiles.png -> atlas source 0 no tileset de chão

# --- Coordenadas atlas (col, row) nos tilesets ---
# Water_tiles.png (24 colunas x 15 linhas aprox.)
const AGUA_CENTRO  := Vector2i(7,  7)   # água central/azul escuro
const AGUA_BORDA_N := Vector2i(7,  6)   # borda norte
const AGUA_BORDA_S := Vector2i(7,  8)   # borda sul
const AGUA_BORDA_L := Vector2i(8,  7)   # borda leste
const AGUA_BORDA_O := Vector2i(6,  7)   # borda oeste
const AGUA_CANTO_NE := Vector2i(8, 6)
const AGUA_CANTO_NW := Vector2i(6, 6)
const AGUA_CANTO_SE := Vector2i(8, 8)
const AGUA_CANTO_SW := Vector2i(6, 8)

# Floors_Tiles.png — tiles de chão/grama
# (baseado na grade 16x16. Linha 0 = verde claro, linha 1 = terra, etc.)
const GRAMA_1 := Vector2i(1,  0)
const GRAMA_2 := Vector2i(2,  0)
const GRAMA_3 := Vector2i(3,  0)
const TERRA_1 := Vector2i(1,  1)
const TERRA_2 := Vector2i(2,  1)
const TERRA_3 := Vector2i(3,  1)
const GRAMA_ESCURA := Vector2i(6, 0)
const CAMINHO     := Vector2i(11, 0)
const CAMINHO_2   := Vector2i(12, 0)
const FLORESTA_BASE := Vector2i(16, 0)

@export_tool_button(\"🌿 Gerar Mundo Completo\") var _btn_gerar  : Callable = func(): _gerar_mundo()
@export_tool_button(\"🗑️ Limpar Mundo\")        var _btn_limpar : Callable = func(): _limpar_mundo()
@export_tool_button(\"🌊 Gerar Só Água\")        var _btn_agua   : Callable = func(): _gerar_agua()
@export_tool_button(\"🌱 Gerar Só Vegetação\")   var _btn_veg    : Callable = func(): _gerar_vegetacao()

# Referências aos layers (não usadas diretamente — layers acessados via has_node)
# @onready var layer_chao  : TileMapLayer = $chao
# @onready var layer_agua  : TileMapLayer = $agua

# Semente pra geração aleatória (troque pra mudar o mundo)
@export var seed_mundo : int = 42
@export var densidade_floresta : float = 0.35  # 0.0 a 1.0
@export var densidade_agua     : float = 0.15
@export var num_rios           : int   = 3

var _rng := RandomNumberGenerator.new()

# =============================================================
func _gerar_mundo() -> void:
	print(\"[GeradorMundo] Iniciando geração...\")
	_rng.seed = seed_mundo
	_garantir_layers()
	_limpar_tudo()
	_gerar_chao_base()
	_gerar_rios()
	_gerar_lagos()
	_gerar_caminhos()
	_gerar_vegetacao_decorativa()
	print(\"[GeradorMundo] ✅ Mundo gerado com sucesso!\")

func _limpar_mundo() -> void:
	_garantir_layers()
	_limpar_tudo()
	print(\"[GeradorMundo] 🗑️ Mundo limpo!\")

func _gerar_agua() -> void:
	_rng.seed = seed_mundo
	_garantir_layers()
	_gerar_rios()
	_gerar_lagos()

func _gerar_vegetacao() -> void:
	_rng.seed = seed_mundo + 999
	_garantir_layers()
	_gerar_vegetacao_decorativa()

# =============================================================
# GARANTIR QUE OS LAYERS EXISTEM
# =============================================================
func _garantir_layers() -> void:
	# Verifica/cria layer de chão
	if not has_node(\"chao\"):
		var l = TileMapLayer.new()
		l.name = \"chao\"
		add_child(l)
		l.owner = get_tree().edited_scene_root
		# Copia o tileset do layer de água como base
		if has_node(\"agua\"):
			pass  # tileset será setado manualmente
		print(\"[GeradorMundo] Layer 'chao' criado\")

	if not has_node(\"detalhe\"):
		var l = TileMapLayer.new()
		l.name = \"detalhe\"
		add_child(l)
		l.owner = get_tree().edited_scene_root
		print(\"[GeradorMundo] Layer 'detalhe' criado\")

func _limpar_tudo() -> void:
	if has_node(\"chao\"):
		$chao.clear()
	if has_node(\"agua\"):
		$agua.clear()
	if has_node(\"detalhe\"):
		$detalhe.clear()

# =============================================================
# 1. CHÃO BASE — preenche tudo com grama
# =============================================================
func _gerar_chao_base() -> void:
	var chao : TileMapLayer = $chao if has_node(\"chao\") else null
	if not chao:
		push_error(\"Layer 'chao' não encontrado!\")
		return

	var tiles_grama := [GRAMA_1, GRAMA_2, GRAMA_3, GRAMA_ESCURA]
	var pesos_grama := [0.5, 0.3, 0.15, 0.05]

	for x in range(MAPA_OFFSET_X, MAPA_OFFSET_X + MAPA_LARGURA):
		for y in range(MAPA_OFFSET_Y, MAPA_OFFSET_Y + MAPA_ALTURA):
			var tile := _escolher_tile_ponderado(tiles_grama, pesos_grama)
			chao.set_cell(Vector2i(x, y), SOURCE_FLOOR, tile)

	print(\"[GeradorMundo] ✅ Chão base gerado (%d tiles)\" % (MAPA_LARGURA * MAPA_ALTURA))

# =============================================================
# 2. RIOS — caminhos sinuosos de água
# =============================================================
func _gerar_rios() -> void:
	var agua : TileMapLayer = $agua if has_node(\"agua\") else null
	if not agua:
		return

	for i in range(num_rios):
		var horizontal := _rng.randf() > 0.5

		if horizontal:
			# Rio horizontal
			var y_inicio := MAPA_OFFSET_Y + _rng.randi_range(10, MAPA_ALTURA - 10)
			var x := MAPA_OFFSET_X
			var y_atual := y_inicio

			while x < MAPA_OFFSET_X + MAPA_LARGURA:
				# Largura do rio varia de 2 a 5 tiles
				var largura := _rng.randi_range(2, 4)
				for dy in range(-largura, largura + 1):
					var pos := Vector2i(x, y_atual + dy)
					_pintar_agua(agua, pos)

				# Serpenteio suave
				if _rng.randf() < 0.3:
					y_atual = clamp(y_atual + _rng.randi_range(-1, 1),
						MAPA_OFFSET_Y + 5, MAPA_OFFSET_Y + MAPA_ALTURA - 5)
				x += 1
		else:
			# Rio vertical
			var x_inicio := MAPA_OFFSET_X + _rng.randi_range(10, MAPA_LARGURA - 10)
			var y := MAPA_OFFSET_Y
			var x_atual := x_inicio

			while y < MAPA_OFFSET_Y + MAPA_ALTURA:
				var largura := _rng.randi_range(2, 4)
				for dx in range(-largura, largura + 1):
					var pos := Vector2i(x_atual + dx, y)
					_pintar_agua(agua, pos)

				if _rng.randf() < 0.3:
					x_atual = clamp(x_atual + _rng.randi_range(-1, 1),
						MAPA_OFFSET_X + 5, MAPA_OFFSET_X + MAPA_LARGURA - 5)
				y += 1

	print(\"[GeradorMundo] ✅ %d rios gerados\" % num_rios)

# =============================================================
# 3. LAGOS — bolsões de água espalhados
# =============================================================
func _gerar_lagos() -> void:
	var agua : TileMapLayer = $agua if has_node(\"agua\") else null
	if not agua:
		return

	var num_lagos := int(MAPA_LARGURA * MAPA_ALTURA * densidade_agua * 0.01)
	num_lagos = clamp(num_lagos, 3, 15)

	for _i in range(num_lagos):
		var cx := _rng.randi_range(MAPA_OFFSET_X + 10, MAPA_OFFSET_X + MAPA_LARGURA - 10)
		var cy := _rng.randi_range(MAPA_OFFSET_Y + 5,  MAPA_OFFSET_Y + MAPA_ALTURA - 5)
		var raio_x := _rng.randi_range(3, 8)
		var raio_y := _rng.randi_range(2, 6)

		# Forma orgânica com ruído
		for x in range(cx - raio_x - 2, cx + raio_x + 2):
			for y in range(cy - raio_y - 2, cy + raio_y + 2):
				var dx := float(x - cx) / raio_x
				var dy := float(y - cy) / raio_y
				var dist := dx * dx + dy * dy
				var ruido := _rng.randf_range(-0.2, 0.2)
				if dist + ruido < 1.0:
					_pintar_agua(agua, Vector2i(x, y))

	print(\"[GeradorMundo] ✅ Lagos gerados\")

func _pintar_agua(agua: TileMapLayer, pos: Vector2i) -> void:
	# Mantém dentro dos limites
	if pos.x < MAPA_OFFSET_X or pos.x >= MAPA_OFFSET_X + MAPA_LARGURA:
		return
	if pos.y < MAPA_OFFSET_Y or pos.y >= MAPA_OFFSET_Y + MAPA_ALTURA:
		return
	agua.set_cell(pos, SOURCE_WATER, AGUA_CENTRO)

# =============================================================
# 4. CAMINHOS — trilhas de terra no mapa
# =============================================================
func _gerar_caminhos() -> void:
	var chao : TileMapLayer = $chao if has_node(\"chao\") else null
	if not chao:
		return

	# Caminho principal horizontal (centro do mapa)
	var y_caminho := MAPA_OFFSET_Y + MAPA_ALTURA / 2
	for x in range(MAPA_OFFSET_X, MAPA_OFFSET_X + MAPA_LARGURA):
		for dy in range(-1, 2):
			var pos := Vector2i(x, y_caminho + dy)
			# Não sobrescreve água
			if _tem_agua(pos):
				continue
			var tile := CAMINHO if dy == 0 else CAMINHO_2
			chao.set_cell(pos, SOURCE_FLOOR, tile)

	# Caminho vertical (cruzando)
	var x_caminho := MAPA_OFFSET_X + MAPA_LARGURA / 2
	for y in range(MAPA_OFFSET_Y, MAPA_OFFSET_Y + MAPA_ALTURA):
		for dx in range(-1, 2):
			var pos := Vector2i(x_caminho + dx, y)
			if _tem_agua(pos):
				continue
			var tile := CAMINHO if dx == 0 else CAMINHO_2
			chao.set_cell(pos, SOURCE_FLOOR, tile)

	print(\"[GeradorMundo] ✅ Caminhos gerados\")

func _tem_agua(pos: Vector2i) -> bool:
	if not has_node(\"agua\"):
		return false
	var agua : TileMapLayer = $agua
	return agua.get_cell_source_id(pos) != -1

# =============================================================
# 5. VEGETAÇÃO DECORATIVA — tiles de detalhe espalhados
# =============================================================
func _gerar_vegetacao_decorativa() -> void:
	var chao : TileMapLayer = $chao if has_node(\"chao\") else null
	if not chao:
		return

	# Tiles de terra/grama mais escura em zonas de floresta
	# Usamos o noise manual com RNG pra criar clusters
	for x in range(MAPA_OFFSET_X, MAPA_OFFSET_X + MAPA_LARGURA):
		for y in range(MAPA_OFFSET_Y, MAPA_OFFSET_Y + MAPA_ALTURA):
			var pos := Vector2i(x, y)
			if _tem_agua(pos):
				continue

			# Zonear o mapa em 4 regiões de floresta
			var zona_floresta := _esta_na_floresta(x, y)
			if zona_floresta and _rng.randf() < densidade_floresta * 0.3:
				chao.set_cell(pos, SOURCE_FLOOR, GRAMA_ESCURA)

	print(\"[GeradorMundo] ✅ Vegetação decorativa adicionada\")

func _esta_na_floresta(x: int, y: int) -> bool:
	# Define 4 zonas de floresta nos cantos do mapa
	var nx := float(x - MAPA_OFFSET_X) / MAPA_LARGURA  # 0..1
	var ny := float(y - MAPA_OFFSET_Y) / MAPA_ALTURA   # 0..1

	# Cantos e bordas são floresta densa
	var dist_borda : float = min(min(nx, 1.0 - nx), min(ny, 1.0 - ny))
	if dist_borda < 0.15:
		return true

	# Clusters aleatórios pelo mapa
	var cluster := sin(nx * 7.3 + seed_mundo) * cos(ny * 5.1 + seed_mundo)
	return cluster > 0.3

# =============================================================
# UTILIDADES
# =============================================================
func _escolher_tile_ponderado(tiles: Array, pesos: Array) -> Vector2i:
	var total := 0.0
	for p in pesos:
		total += p
	var r := _rng.randf() * total
	var acum := 0.0
	for i in range(tiles.size()):
		acum += pesos[i]
		if r <= acum:
			return tiles[i]
	return tiles[0]
"

